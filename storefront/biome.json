{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": ["**", "!dist", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useArrowFunction": "error"
      },
      "style": {
        "useComponentExportOnlyModules": "error"
      },
      "nursery": {
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "expression"
          }
        },
        "useExplicitType": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/main.tsx", "src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@opentelemetry/*", "web-vitals"],
                    "message": "Isolate OpenTelemetry and web-vitals imports inside src/telemetry/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@opentelemetry/*", "web-vitals"],
                    "message": "Isolate OpenTelemetry and web-vitals imports inside src/telemetry/."
                  },
                  {
                    "group": ["**/app/**", "**/app"],
                    "message": "Keep features/ free of imports from app/ (unidirectional: app -> features -> components/telemetry/lib)."
                  },
                  {
                    "group": [
                      "../catalog/**",
                      "../cart/**",
                      "../checkout/**",
                      "../orders/**",
                      "../diagnostics/**"
                    ],
                    "message": "Avoid cross-feature deep imports; share cross-feature state via URL routes, src/lib/, or providers in src/app/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**", "src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@opentelemetry/*", "web-vitals"],
                    "message": "Isolate OpenTelemetry and web-vitals imports inside src/telemetry/."
                  },
                  {
                    "group": ["**/features/**", "**/features", "**/app/**", "**/app"],
                    "message": "Keep components/ and lib/ free of imports from features/ or app/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/telemetry/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/features/**", "**/features", "**/app/**", "**/app"],
                    "message": "Keep telemetry/ free of imports from features/ or app/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ]
}
