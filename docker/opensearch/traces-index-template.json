{
  "index_patterns": ["ss4o_traces-*"],
  "priority": 200,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "default_pipeline": "observe-it-traces-pipeline"
      }
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date_nanos" },
        "startTime": { "type": "date_nanos" },
        "endTime": { "type": "date_nanos" },
        "traceId": { "type": "keyword" },
        "spanId": { "type": "keyword" },
        "parentSpanId": { "type": "keyword" },
        "traceState": { "type": "keyword" },
        "name": { "type": "keyword" },
        "kind": { "type": "keyword" },
        "durationInNanos": { "type": "long" },
        "durationMs": { "type": "double" },
        "service": { "type": "keyword" },
        "serviceName": { "type": "keyword" },
        "version": { "type": "keyword" },
        "env": { "type": "keyword" },
        "droppedAttributesCount": { "type": "integer" },
        "droppedEventsCount": { "type": "integer" },
        "droppedLinksCount": { "type": "integer" },
        "status": {
          "properties": {
            "code": { "type": "keyword" },
            "message": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        },
        "events": {
          "type": "object",
          "properties": {
            "time": { "type": "date_nanos" },
            "name": { "type": "keyword" },
            "droppedAttributesCount": { "type": "integer" },
            "attributes": {
              "properties": {
                "exception": {
                  "properties": {
                    "type": { "type": "keyword" },
                    "message": {
                      "type": "text",
                      "fields": {
                        "keyword": {
                          "type": "keyword",
                          "ignore_above": 1024
                        }
                      }
                    },
                    "stacktrace": { "type": "text" }
                  }
                },
                "order": {
                  "properties": {
                    "state": { "type": "keyword" },
                    "previous_state": { "type": "keyword" }
                  }
                },
                "inventory": {
                  "properties": {
                    "sku": { "type": "keyword" },
                    "requested_quantity": { "type": "long" },
                    "available_quantity": { "type": "long" },
                    "outcome": { "type": "keyword" }
                  }
                }
              }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "traceId": { "type": "keyword" },
            "spanId": { "type": "keyword" },
            "traceState": { "type": "keyword" },
            "droppedAttributesCount": { "type": "integer" }
          }
        },
        "resource": {
          "properties": {
            "service": {
              "properties": {
                "name": { "type": "keyword" },
                "version": { "type": "keyword" },
                "instance": {
                  "properties": {
                    "id": { "type": "keyword" }
                  }
                }
              }
            },
            "deployment": {
              "properties": {
                "environment": {
                  "properties": {
                    "name": { "type": "keyword" }
                  }
                }
              }
            },
            "telemetry": {
              "properties": {
                "sdk": {
                  "properties": {
                    "name": { "type": "keyword" },
                    "language": { "type": "keyword" },
                    "version": { "type": "keyword" }
                  }
                }
              }
            }
          }
        },
        "instrumentationScope": {
          "properties": {
            "name": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        "attributes": {
          "properties": {
            "order": {
              "properties": {
                "id": { "type": "keyword" },
                "state": { "type": "keyword" },
                "previous_state": { "type": "keyword" },
                "currency": { "type": "keyword" },
                "attempted_action": { "type": "keyword" },
                "total_amount": { "type": "double" },
                "item_count": { "type": "long" }
              }
            },
            "customer": {
              "properties": {
                "id": { "type": "keyword" }
              }
            },
            "checkout": {
              "properties": {
                "scenario": { "type": "keyword" }
              }
            },
            "inventory": {
              "properties": {
                "sku": { "type": "keyword" },
                "requested_quantity": { "type": "long" },
                "available_quantity": { "type": "long" },
                "outcome": { "type": "keyword" }
              }
            },
            "payment": {
              "properties": {
                "method": { "type": "keyword" },
                "outcome": { "type": "keyword" },
                "latency_ms": { "type": "long" }
              }
            },
            "shipping": {
              "properties": {
                "method": { "type": "keyword" }
              }
            },
            "cancellation": {
              "properties": {
                "reason": { "type": "keyword" }
              }
            },
            "error": {
              "properties": {
                "type": { "type": "keyword" }
              }
            },
            "db": {
              "properties": {
                "system": {
                  "properties": {
                    "name": { "type": "keyword" }
                  }
                },
                "namespace": { "type": "keyword" },
                "collection": {
                  "properties": {
                    "name": { "type": "keyword" }
                  }
                },
                "operation": {
                  "properties": {
                    "name": { "type": "keyword" },
                    "batch": {
                      "properties": {
                        "size": { "type": "long" }
                      }
                    }
                  }
                },
                "query": {
                  "properties": {
                    "text": {
                      "type": "keyword",
                      "ignore_above": 8192
                    },
                    "summary": { "type": "keyword" }
                  }
                },
                "response": {
                  "properties": {
                    "status_code": { "type": "keyword" }
                  }
                }
              }
            },
            "http": {
              "properties": {
                "request": {
                  "properties": {
                    "method": { "type": "keyword" },
                    "method_original": { "type": "keyword" }
                  }
                },
                "response": {
                  "properties": {
                    "status_code": { "type": "long" }
                  }
                },
                "route": { "type": "keyword" }
              }
            },
            "url": {
              "properties": {
                "scheme": { "type": "keyword" },
                "path": { "type": "keyword" },
                "query": { "type": "keyword" },
                "full": { "type": "keyword" }
              }
            },
            "server": {
              "properties": {
                "address": { "type": "keyword" },
                "port": { "type": "long" }
              }
            },
            "client": {
              "properties": {
                "address": { "type": "keyword" },
                "port": { "type": "long" }
              }
            },
            "network": {
              "properties": {
                "protocol": {
                  "properties": {
                    "name": { "type": "keyword" },
                    "version": { "type": "keyword" }
                  }
                },
                "peer": {
                  "properties": {
                    "address": { "type": "keyword" },
                    "port": { "type": "long" }
                  }
                },
                "transport": { "type": "keyword" },
                "type": { "type": "keyword" }
              }
            },
            "thread": {
              "properties": {
                "name": { "type": "keyword" },
                "id": { "type": "long" }
              }
            },
            "code": {
              "properties": {
                "namespace": { "type": "keyword" },
                "function": { "type": "keyword" },
                "filepath": { "type": "keyword" },
                "lineno": { "type": "long" }
              }
            }
          }
        }
      }
    }
  }
}
